{
  "name": "gdarko/digital-license-manager",
  "description": "Efficiently sell and manage software license keys on WordPress. Works standalone or integrates with WooCommerce for selling licenses.",
  "version": "2.0.0-rc.6",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "keywords": [
    "wordpress",
    "wordpress-plugin",
    "woocommerce",
    "license-manager",
    "license-keys",
    "digital-licenses",
    "software-licensing",
    "ecommerce"
  ],
  "homepage": "https://codeverve.com/product/digital-license-manager-pro/",
  "authors": [
    {
      "name": "CodeVerve",
      "homepage": "https://codeverve.com/",
      "role": "Developer"
    }
  ],
  "support": {
    "email": "info@codeverve.com",
    "issues": "https://wordpress.org/support/plugin/digital-license-manager/",
    "source": "https://wordpress.org/plugins/digital-license-manager/"
  },
  "autoload": {
    "psr-4": {
      "IdeoLogix\\DigitalLicenseManager\\": "includes/"
    },
    "files": [
      "./helpers.php"
    ]
  },
  "require": {
    "ext-openssl": "*",
    "ext-json": "*",
    "defuse/php-encryption": "^2.4",
    "ignitekit/wp-notices": "^1.0",
    "ignitekit/wp-query-builder": "^1.3",
    "ignitekit/wp-deactivate-feedback-client": "^1.0",
    "spipu/html2pdf": "^5.2",
    "tecnickcom/tcpdf": "^6.10"
  },
  "require-dev": {
    "yoast/phpunit-polyfills": "^1.0",
    "wp-phpunit/wp-phpunit": "^7.0"
  },
  "config": {
    "optimize-autoloader": true
  },
  "scripts": {
    "clean-up": [
      "bash scripts/clean_up.sh"
    ],
    "post-install-cmd": [
      "@clean-up"
    ],
    "post-update-cmd": [
      "@clean-up"
    ]
  }
}
